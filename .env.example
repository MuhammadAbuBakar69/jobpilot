# The LLM extractor is optional. With no key, jobpilot uses the offline heuristics.

# Option A - FastRouter (one key, many models). Model ids are namespaced:
#   openai/gpt-4o-mini, anthropic/claude-haiku-5.5, google/gemini-4-argon ...
FASTROUTER_API_KEY=

# Option B - OpenAI directly, or any OpenAI-compatible server (Azure, Groq, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Override the model. Defaults to openai/gpt-4o-mini on FastRouter, gpt-4o-mini elsewhere.
JOBPILOT_MODEL=
